DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="your-super-secret-jwt-key"

# CLIENT_URL is the user frontend application URL (primary)
CLIENT_URL="http://localhost:8080"
# ADMIN_URL is the admin frontend application URL (optional, falls back to CLIENT_URL)
ADMIN_URL="http://localhost:5173"
# API_BASE_URL should NOT include /api prefix - it is added automatically
API_BASE_URL="http://localhost:3000"
# Legacy URL fallbacks (used only when CLIENT_URL / API_BASE_URL are unset)
# APP_BASE_URL="http://localhost:8081"
# APP_URL="http://localhost:8081"
# CLIENT_APP_URL="http://localhost:8081"
# API_URL="http://localhost:3000"
TOKEN_IDLE_TIMEOUT_MINUTES=30

# Squad Payment Gateway
SQUAD_SECRET_KEY=
SQUAD_ENV=sandbox

# Monnify Payment Gateway
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Production URL: https://api.monnify.com
MONNIFY_WALLET_ACCOUNT_NUMBER=

# Flutterwave Payment Gateway (V3 - https://developer.flutterwave.com/)
# Get all keys from Dashboard -> Settings -> API Keys.
# Same API base for test & live; the key prefix determines the mode
# (test keys contain FLWSECK_TEST / FLWPUBK_TEST).
FLW_SECRET_KEY=
# Public key (FLWPUBK_...): used CLIENT-SIDE for inline checkout (v3.js
# FlutterwaveCheckout) and mobile SDKs. Server API calls use the secret key.
# Served to clients via the public GET /providers/checkout-config endpoint.
FLW_PUBLIC_KEY=
# Secret hash (webhook secret) - set the SAME value in the Flutterwave
# dashboard: Settings -> Webhooks -> Secret hash. Flutterwave sends it back
# in the `verif-hash` header; requests without a match are rejected (401).
FLW_SECRET_HASH=
# Optional: encryption key (32 chars) - ONLY needed for Direct Charge
# endpoints (3DES payload encryption). Not required for hosted/standard
# checkout, transfers, virtual accounts or verification.
# FLW_ENCRYPTION_KEY=
# Optional override (defaults to https://api.flutterwave.com)
FLW_BASE_URL=https://api.flutterwave.com

# Default Payment Provider (squad, monnify, or flutterwave)
# Note: the globally active provider can also be toggled at runtime by
# platform admins (system_settings.active_payment_provider), which takes
# precedence over this env value.
DEFAULT_PAYMENT_PROVIDER=flutterwave

# SMS Service (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# SMS Service (Kudi)
KUDI_API_KEY=
KUDI_SENDER_ID=

# Default SMS Provider (termii or kudi)
DEFAULT_SMS_PROVIDER=termii

# Default WhatsApp Provider (meta or termii)
DEFAULT_WHATSAPP_PROVIDER=meta

# Meta WhatsApp Business API
META_GRAPH_API_URL=https://graph.facebook.com/v20.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Termii WhatsApp Number (required for Termii WhatsApp sending)
TERMII_WHATSAPP_NUMBER=

# Redis for Caching & BullMQ
REDIS_URL="redis://localhost:6379"
# Set to true for local development when Redis is not running/reachable.
DISABLE_REDIS=false
REDIS_CONNECT_TIMEOUT_MS=5000
REDIS_MAX_RETRIES=1

# Sentry for Error Monitoring
SENTRY_DSN=

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=

# Google SSO (Google Identity Services / OAuth2)
# Create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=

# WebRTC / mediasoup (standalone Node server only - NOT Netlify serverless)
MEDIASOUP_ANNOUNCED_IP=127.0.0.1
MEDIASOUP_RTC_MIN_PORT=40000
MEDIASOUP_RTC_MAX_PORT=40100
PORT=3000

# ─────────────────────────────────────────────────────────────
# CORS & Logging
# ─────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins
# (e.g. https://app.example.com,https://admin.example.com). Leave empty to
# use the built-in defaults.
CORS_ORIGINS=
# Application log level (trace|debug|info|warn|error|fatal)
LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────
# Security secrets - REQUIRED before going live
# (the server logs a warning at boot if any of these is missing)
# ─────────────────────────────────────────────────────────────
# Protects cron/subscription endpoints (sent as x-cron-secret header)
CRON_SECRET=
# Protects /internal/jobs endpoints (sent as x-job-secret header)
JOBS_SECRET=
# Signs transaction audit hashes - must be a strong unique random string
TRANSACTION_HASH_SECRET=

# ─────────────────────────────────────────────────────────────
# Email - Brevo API (preferred) or SMTP fallback
# ─────────────────────────────────────────────────────────────
# Brevo requires BOTH BREVO_API_KEY and BREVO_BASE_URL to be set.
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
# BREVO_TIMEOUT_SECONDS=15
# SMTP fallback (used only when the Brevo vars above are not set)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=

# ─────────────────────────────────────────────────────────────
# KYC / Identity verification (Prembly)
# ─────────────────────────────────────────────────────────────
# KYC mode: live or sandbox (defaults to live)
KYC=live
# Comma-separated admin emails allowed to review KYC submissions
KYC_ADMIN_EMAILS=
PREMBLY_API_KEY=
PREMBLY_APP_ID=
# PREMBLY_BASE_URL=https://api.prembly.com
# PREMBLY_TIMEOUT_SECONDS=30

# ─────────────────────────────────────────────────────────────
# AI features (product documentation generator)
# ─────────────────────────────────────────────────────────────
# openai | google - auto-detected from the keys below when omitted
# AI_PROVIDER=google
# Google Gemini (GOOGLE_AI_KEY or GEMINI_API_KEY both work)
GEMINI_API_KEY=
# GOOGLE_AI_KEY=
# OPENAI_API_KEY=

# ─────────────────────────────────────────────────────────────
# Database & misc
# ─────────────────────────────────────────────────────────────
# Set to "disable" ONLY for local Postgres without TLS. Managed providers
# (Supabase/Neon/RDS) should keep TLS enabled (default).
# PGSSLMODE=
# Custom response body for GET /ping (uptime monitors)
# PING_MESSAGE=ping
