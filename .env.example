DATABASE_URL="postgresql://user:password@host:port/database"
JWT_SECRET="your-super-secret-jwt-key"

CLIENT_URL="http://localhost:8081"
# API_BASE_URL should NOT include /api prefix - it is added automatically
API_BASE_URL="http://localhost:3000"
TOKEN_IDLE_TIMEOUT_MINUTES=30

# Squad Payment Gateway
SQUAD_SECRET_KEY=
SQUAD_ENV=sandbox

# Monnify Payment Gateway
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Production URL: https://api.monnify.com
MONNIFY_WALLET_ACCOUNT_NUMBER=

# Default Payment Provider (squad or monnify)
DEFAULT_PAYMENT_PROVIDER=squad

# SMS Service (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# SMS Service (Kudi)
KUDI_API_KEY=
KUDI_SENDER_ID=

# Default SMS Provider (termii or kudi)
DEFAULT_SMS_PROVIDER=termii

# Default WhatsApp Provider (meta or termii)
DEFAULT_WHATSAPP_PROVIDER=meta

# Meta WhatsApp Business API
META_GRAPH_API_URL=https://graph.facebook.com/v20.0
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=

# Termii WhatsApp Number (required for Termii WhatsApp sending)
TERMII_WHATSAPP_NUMBER=

# Redis for Caching & BullMQ
REDIS_URL="redis://localhost:6379"

# Sentry for Error Monitoring
SENTRY_DSN=

# Cloudflare R2 Storage
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_PUBLIC_URL=